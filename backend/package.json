{
  "name": "skillproof-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status"
  },
  "dependencies": {
    "@skillproof/shared": "*",
    "@types/multer": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "java-parser": "^3.0.1",
    "jose": "^5.9.6",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.9.3",
    "multer": "^2.5.0",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.27.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/nock": "^10.0.3",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "nock": "^15.0.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
