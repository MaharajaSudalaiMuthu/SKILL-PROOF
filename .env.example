# SkillProof Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to version control or hardcode secrets.

# Application Server
PORT=8080
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# MongoDB Connection
# In Docker Compose, replica set is available at localhost:27017/?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/skillproof?replicaSet=rs0

# Application JWT Session Secret (Min 32 characters for HMAC SHA-256)
JWT_SECRET=replace_with_at_least_32_characters_random_session_secret_value

# AES-256-GCM Token Encryption Key (64-character hex string representing 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub OAuth App Credentials (Required for Phase 2)
# Register at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret

# Ed25519 Credential Signing Key Path (Mode 600)
# Generate with: openssl genpkey -algorithm ed25519 -out keys/ed25519-private.pem
SIGNING_KEY_PATH=keys/ed25519-private.pem

# Sandbox Runner Security
SANDBOX_RUNNER_URL=http://127.0.0.1:8081
SANDBOX_RUNNER_SECRET=replace_with_at_least_32_characters_random_hmac_secret_key
